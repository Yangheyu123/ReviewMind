APP_NAME=ReviewMind API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
GITHUB_TOKEN=your_github_token_here
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=10

# GitHub Webhook / Bot 集成
# Webhook 密钥（用于校验 X-Hub-Signature-256，必填才能启用 webhook）
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
# 评论触发词（大小写不敏感，出现在 PR 评论正文中即触发审查）
GITHUB_REVIEW_TRIGGER=@reviewmind review
# Bot 自身账号 login，用于过滤自回复避免死循环
GITHUB_BOT_LOGIN=reviewmind
# 允许触发的仓库白名单（空列表表示不限），形如 ["owner/repo"]
GITHUB_ALLOWED_REPOS=[]
# PR opened 自动触发审查（仅 opened，push/synchronize 等更新不触发）；默认关闭
GITHUB_AUTO_REVIEW_ON_PR_OPENED=false
# 等待审查完成后回写报告评论的超时与轮询间隔（秒）
GITHUB_WEBHOOK_RESULT_TIMEOUT_SECONDS=1800
GITHUB_WEBHOOK_RESULT_POLL_SECONDS=2.0

LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=https://ai.sxuan.top/v1
LLM_MODEL_SUMMARY=glm-5.1
LLM_MODEL_REVIEW=glm-5.1
LLM_TIMEOUT_SECONDS=60
LLM_MOCK_MODE=false

# PostgreSQL + pgvector（默认）
DATABASE_URL=postgresql+asyncpg://reviewmind:reviewmind@localhost:5432/reviewmind
# 本地无 PostgreSQL 时，可切回 SQLite：
# DATABASE_URL=sqlite+aiosqlite:///./reviewmind.db

# Redis（可选，不配置则自动降级为无缓存）
REDIS_URL=redis://localhost:6379/0

# Embedding 配置（用于 pgvector 向量检索）
# 方式一：付费/自建 OpenAI 兼容服务
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_API_BASE=https://ai.sxuan.top/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# 方式二：Gitee Serverless 免费向量大模型（推荐，无需付费）
# 模型 Qwen3-Embedding-8B 固定输出 1024 维，需在 DATABASE_URL 用 pgvector 重建索引
# EMBEDDING_API_KEY=your_gitee_access_token_here
# EMBEDDING_API_BASE=https://ai.gitee.com/v1
# EMBEDDING_MODEL=Qwen3-Embedding-8B
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_EXTRA_HEADERS={"X-Failover-Enabled":"true"}